# ===== ProjectMind AI — Backend (Express) env =====
# Copy to `.env` for local dev. In production (Render) set these in the dashboard.

# Local port. On Render this is provided automatically — do NOT set it there.
PORT=5000
NODE_ENV=development

# The frontend origin allowed by CORS.
#   local:      http://localhost:3000
#   production: https://<your-app>.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional: extra allowed browser origins, comma-separated (custom domains, etc.).
# *.vercel.app preview URLs are always allowed automatically.
# ALLOWED_ORIGINS=https://your-custom-domain.com

# The Python FastAPI AI service base URL — MUST include the /api/v1/ai path.
#   local:      http://localhost:8000/api/v1/ai
#   production: https://<your-ai-worker>.onrender.com/api/v1/ai
FASTAPI_URL=http://localhost:8000/api/v1/ai

# Clerk auth (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Supabase (Project Settings -> API). Use the SERVICE ROLE key (server-only, secret).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Passcode for the Admin portal gate. Pick any strong value.
ADMIN_PASSCODE=change-me
