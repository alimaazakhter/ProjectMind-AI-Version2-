# ===== ProjectMind AI — Python FastAPI AI service env =====
# Copy to `.env` for local dev. In production (Render) set these in the dashboard.

# Google Gemini API key (https://aistudio.google.com/). Add billing to remove the
# free-tier daily quota (20 requests/day/model).
GEMINI_API_KEY=your-gemini-api-key

# Primary model. Falls back automatically across several fast models when quota runs out.
GEMINI_MODEL=gemini-3.5-flash

# Local server bind. On Render the port is provided via $PORT (see startCommand), so
# these are only used for local dev.
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Allowed origins (comma-separated). The service is called server-to-server by the
# backend, so this is mostly belt-and-suspenders.
#   local:      http://localhost:3000,http://localhost:5000
#   production: https://<your-backend>.onrender.com,https://<your-app>.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
