# ===== ProjectMind AI — Frontend (Next.js) env =====
# Copy to `.env.local` for local dev. In production (Vercel) set these in the dashboard.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets in them.

# The Express backend base URL (include /api/v1).
#   local:      http://localhost:5000/api/v1
#   production: https://<your-backend>.onrender.com/api/v1
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:5000/api/v1

# Optional legacy alias some code reads; keep it in sync with the URL above.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Set to "true" only to run the UI on mock data with no backend. Leave false in prod.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Clerk auth (https://dashboard.clerk.com). Only the PUBLISHABLE key is public;
# CLERK_SECRET_KEY is server-side and must stay secret.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk routing (keep as-is unless you customize the auth routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
